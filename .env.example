# k5n Recipes Environment Configuration
# Copy this file to .env and update with your actual values
# DO NOT commit .env to version control!

# Database Configuration
DB_HOST=127.0.0.1
DB_DATABASE=recipes
DB_LOGIN=your_username
DB_PASSWORD=your_password

# Authentication
# Modes: open (no auth), pin (shared pin for edits), user (multi-user accounts)
AUTH_MODE=open
# Required for 'pin' mode
ACCESS_PIN=1234

# Application Environment
# Options: development, production
APP_ENV=production

# Session storage (strongly recommended)
#
# Where PHP writes session files. MUST be a directory outside the web root:
# every path in this app is web-served, so a session directory inside the
# project can be fetched over HTTP by anyone who knows a session id. Do not
# count on .htaccess to prevent that — AllowOverride is None by default on
# Debian/Ubuntu, which silently disables it.
#
# Create it once, owned by the web server user and readable only by it:
#   sudo mkdir -p /var/www/recipes-sessions
#   sudo chown www-data:www-data /var/www/recipes-sessions
#   sudo chmod 700 /var/www/recipes-sessions
#
# Leave this unset and PHP's default applies. On Debian/Ubuntu that directory is
# swept every 30 minutes using the php.ini gc_maxlifetime (1440s), which expires
# sessions after ~24 minutes and surfaces as spurious "Invalid CSRF token"
# errors on slow form fills. Setting this avoids that and gives a 4 hour
# lifetime.
SESSION_SAVE_PATH=/var/www/recipes-sessions
