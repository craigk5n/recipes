{
    "name": "k5n/recipes",
    "description": "k5n Recipes - PHP Recipe Management Application",
    "type": "project",
    "license": "MIT",
    "authors": [
        {
            "name": "k5n Team"
        }
    ],
    "require": {
        "php": ">=7.4",
        "twbs/bootstrap": "^5.3",
        "components/jquery": "^3.6"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.0|^10.0",
        "squizlabs/php_codesniffer": "^3.7",
        "phpstan/phpstan": "^1.10"
    },
    "autoload": {
        "classmap": [
            "includes/"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Recipes\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "phpcs": "phpcs --standard=PSR12 includes/",
        "phpstan": "phpstan analyse includes/ --level=5",
        "lint": "phpcs --standard=PSR12 includes/ && phpstan analyse includes/ --level=5",
        "install-assets": "php scripts/install-assets.php",
        "post-install-cmd": [
            "@install-assets"
        ],
        "post-update-cmd": [
            "@install-assets"
        ]
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
