<?xml version="1.0"?>
<ruleset name="k5n Recipes">
    <description>PSR-12, with carve-outs for the legacy bootstrap files in includes/.</description>

    <!-- Analyse the procedural layer. src/ is covered by phpstan but is not
         style-checked yet; add it here once it is clean. -->
    <file>includes/</file>

    <arg name="colors"/>
    <arg value="sp"/>

    <!-- Generated by install/index.php, gitignored, and holds its values inside a
         comment block that Config::parseLegacySettingsFile() reads by regex.
         Reformatting it would risk the live DB credentials for no benefit. -->
    <exclude-pattern>includes/settings.php</exclude-pattern>

    <!-- HTML partials that carry a .php extension only so they can be included.
         They contain no PHP, so there is nothing here to style-check. -->
    <exclude-pattern>includes/js.php</exclude-pattern>
    <exclude-pattern>includes/styles.php</exclude-pattern>

    <rule ref="PSR12"/>

    <!-- These three bootstrap the app: each defines the legacy shim functions and
         also configures sessions/headers/config at include time. Doing both in one
         file is precisely what this sniff forbids, but the fix is the ongoing
         migration to src/, not a contortion of the shims. -->
    <rule ref="PSR1.Files.SideEffects.FoundWithSymbols">
        <exclude-pattern>includes/config.php</exclude-pattern>
        <exclude-pattern>includes/pdo_db.php</exclude-pattern>
        <exclude-pattern>includes/security.php</exclude-pattern>
    </rule>
</ruleset>
