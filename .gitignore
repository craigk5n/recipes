# Database credentials
includes/settings.php
.env

# Composer dependencies
vendor/

# Frontend assets (copied from vendor/ by composer install)
# The pub directory is kept, but files inside are auto-generated
pub/*
!pub/.gitkeep

# Logs
logs/

# storage/ is not used by default — sessions live at SESSION_SAVE_PATH, outside
# the web root. Ship only the deny-all guard, never any file written here.
storage/*
!storage/.htaccess

# PHPUnit local test-run cache
.phpunit.cache/

# Documentation for Claude
.claude/
