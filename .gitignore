# Database credentials
includes/settings.php
.env

# Composer dependencies
vendor/

# Frontend assets (copied from vendor/ by composer install)
# The pub directory is kept, but files inside are auto-generated
pub/*
!pub/.gitkeep

# Logs
logs/

# PHP session files (see session.save_path in includes/security.php)
storage/sessions/*
!storage/sessions/.gitkeep

# PHPUnit local test-run cache
.phpunit.cache/

# Documentation for Claude
.claude/
